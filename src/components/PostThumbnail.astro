---
import '../styles/global.css'
import FormattedDate from './FormattedDate.astro'
import ImageWrapper from './ImageWrapper.astro'

const { id, data } = Astro.props
const hasMultipleImages = data.images && data.images.length > 0
---

<a href={`/${id}/`} class="post-card">
  <div class={`post ${hasMultipleImages ? 'multiple-imgs' : ''}`}>
    <ImageWrapper
      url={data.heroImage.url}
      source={data.heroImage.source}
      width={data.heroImage.width}
      height={data.heroImage.height}
      alt={data.heroImage.alt}
    />
    <h3>
      <span class="plaque">
        <span class="plaque-title">{data.title}</span>
        <span class="plaque-details">
          {data.heroImage.medium}, <FormattedDate date={data.pubDate} />
        </span>
      </span>
    </h3>
  </div>
</a>
<style>
  a {
    display: block;
    width: 100%;
    /* Height is driven by the image, never by the grid rows it spans. */
    align-self: start;
  }

  figure {
    margin: 0;
  }

  h3 {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 5%;
    text-align: left;
    font-family: 'Oranienbaum', serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.5;
  }

  .plaque {
    padding: 8px;
    background-color: #fff;
    color: var(--text);
  }

  .plaque-title {
    display: block;
  }

  .plaque-details {
    display: block;
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
  }

  .post {
    position: relative;
    width: 100%;
    cursor: pointer;
  }

  .post :global(img) {
    border-radius: 0;
  }

  .multiple-imgs:before {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    background-image: url('../assets/icons/layers.svg');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 18px;
    filter: brightness(0) invert(1);
  }

  .multiple-imgs img {
    border-radius: 0;
  }

  @media (min-width: 720px) {
    h3 {
      display: none;
      font-size: 22px;
    }

    .post:hover h3 {
      display: flex;
    }
  }
</style>
