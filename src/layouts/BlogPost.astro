---
import '../styles/global.css'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { Icon } from 'astro-icon/components'
import ImageModal from '../components/ImageModal.astro'

type Props = CollectionEntry<'blog'>['data']

const { title, description, pubDate, images } = Astro.props

const backHref = new URL('..', Astro.url).pathname
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0 auto;
        display: flex;
      }

      article {
        width: 100%;
      }

      .prose {
        margin: auto;
        color: rgb(var(--gray-dark));
        display: flex;
        gap: 16px;
        flex-direction: column;
      }

      .prose img {
        border-radius: 0;
      }

      .post-header {
        font-family: 'Oranienbaum', serif;
        color: var(--text);
        font-size: 22px;
        margin: 1em 0;
        text-align: center;
        line-height: 1.3;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
      }

      .date {
        margin-bottom: 0.5em;
        font-style: italic;
        font-size: 14px;
        font-family: 'Atkinson';
      }
      .last-updated-on {
        font-style: italic;
      }
      .images-gallery {
        display: grid;
        flex: 1;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1em;
      }

      .images-gallery img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        object-position: center;
        border-radius: 0;
      }

      .content {
        width: 100%;
        padding: 0 0 2em;
      }

      .back {
        justify-self: start;
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        margin: 5px 0;
      }

      .back a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text);
        text-decoration: none;
      }

      .back a:hover {
        color: var(--accent);
      }

      .back svg {
        width: 24px;
        height: 24px;
      }

      .header-content {
        justify-self: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .spacer {
        justify-self: end;
        min-height: 24px;
      }

      .notes {
        list-style-type: disc;
        list-style-position: inside;
      }

      .prose-grid {
        column-count: 2;
        column-gap: 2px;
      }

      .prose-grid img {
        border-radius: 0;
        margin-bottom: 1em;
        cursor: pointer;
        transition: opacity 0.2s;
      }

      .prose-grid img:hover {
        opacity: 0.9;
      }

      .images-gallery img {
        cursor: pointer;
        transition: opacity 0.2s;
      }

      .images-gallery img:hover {
        opacity: 0.9;
      }

      @media (min-width: 720px) {
        main {
          width: calc(100% - 10em);
        }

        .hero-image {
          display: block;
          width: 100%;
        }

        .content {
          width: auto;
          margin: 0 2em;
        }

        .prose {
          justify-content: center;
          flex-direction: row;
          padding: 0 0 6em;
        }

        .post-header {
          margin: 0 0 1em;
        }

        .prose-grid {
          column-gap: 16px;
          column-count: 3;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="post-header">
          <div class="back">
            <a href={backHref} aria-label="Go back">
              <Icon name="arrow-left" class="icon" stroke-width={4} />
              <span class="sr-only">Back</span>
            </a>
          </div>
          <div class="header-content">
            <h1>{title}</h1>
            <div class="date">
              <FormattedDate date={pubDate} />
            </div>
          </div>
          <div class="spacer" aria-hidden="true"></div>
        </div>
        <div class="prose-grid">
          {
            images?.map(({ image }, idx) => (
              <figure>
                <Image
                  width={image.width}
                  height={image.height}
                  src={image}
                  alt={`Image ${idx + 1} of ${images.length}`}
                  quality={100}
                  data-image-index={idx}
                  class="gallery-image"
                />
              </figure>
            ))
          }
        </div>
      </article>
    </main>
    <Footer />

    {images && <ImageModal client:load images={images} />}
  </body>
</html>
