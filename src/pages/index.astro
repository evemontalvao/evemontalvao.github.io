---
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import PostThumbnail from '../components/PostThumbnail.astro'

const posts = (await getCollection('blog')).sort(
  (firstPost, secondPost) =>
    secondPost.data.pubDate.valueOf() - firstPost.data.pubDate.valueOf(),
)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oranienbaum&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <style>
      .posts {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2px;
      }

      @media (min-width: 720px) {
        .posts {
          /* Capped so tiles stay small enough to read as one field rather
             than a row of slabs. */
          max-width: 1280px;
          margin-inline: auto;
          grid-template-columns: repeat(2, 1fr);
          /* Fine-grained rows: each card spans however many it needs, so
             cards stack independently instead of aligning to a row height. */
          grid-auto-rows: 1px;
          row-gap: 0;
          column-gap: 8px;
        }
      }

      @media (min-width: 1024px) {
        .posts {
          grid-template-columns: repeat(3, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="posts">
        {posts.map((post) => <PostThumbnail {...post} />)}
      </div>
    </main>
    <Footer />
    <script>
      const MASONRY_MIN_VIEWPORT_WIDTH_PX = 720
      const MASONRY_VERTICAL_GAP_PX = 8

      function updatePostRowSpans() {
        const postCards =
          document.querySelectorAll<HTMLElement>('.post-card')
        const isMasonryActive =
          window.innerWidth >= MASONRY_MIN_VIEWPORT_WIDTH_PX

        postCards.forEach((postCard) => {
          if (!isMasonryActive) {
            postCard.style.removeProperty('grid-row-end')
            return
          }

          const cardHeight = postCard.getBoundingClientRect().height
          const rowSpan = Math.ceil(cardHeight + MASONRY_VERTICAL_GAP_PX)
          postCard.style.gridRowEnd = `span ${rowSpan}`
        })
      }

      function scheduleRowSpanUpdate() {
        window.requestAnimationFrame(updatePostRowSpans)
      }

      scheduleRowSpanUpdate()
      window.addEventListener('resize', scheduleRowSpanUpdate)
      document.fonts.ready.then(scheduleRowSpanUpdate)
      document
        .querySelectorAll('.post-card img')
        .forEach((postImage) =>
          postImage.addEventListener('load', scheduleRowSpanUpdate),
        )
    </script>
  </body>
</html>
